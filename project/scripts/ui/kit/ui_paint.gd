@tool
extends RefCounted

## Paint for the Scroll & Ink language. Painted textures (paper, parchment,
## dry-brush strokes, lacquered rods, sky, sun, water, mountains, ribbons)
## live in res://assets/ui/paint/ and are generated by
## tools/paint/gen_textures.py. Brush-edged polygon shapes and seals are
## still built in code for small marks.
##
## Nodes that draw paper must set `texture_repeat = TEXTURE_REPEAT_ENABLED`
## so the grain tiles.

const T = preload("res://scripts/ui/kit/ui_tokens.gd")

const PAINT_DIR := "res://assets/ui/paint/"

static var _grain: Texture2D
static var _glow: GradientTexture2D
static var _cache: Dictionary = {}
static var _parch_box: StyleBoxTexture

## A painted texture by file stem, e.g. tex("sky") → assets/ui/paint/sky.png.
static func tex(stem: String) -> Texture2D:
	if not _cache.has(stem):
		_cache[stem] = load(PAINT_DIR + stem + ".png")
	return _cache[stem]

# =====================================================================
# Textures
# =====================================================================

## Tileable paper grain (512², near-white fibers and mottling). Multiply a
## color by it (via polygon UVs, uv = pos / 512) to get paper.
static func grain() -> Texture2D:
	if _grain == null:
		_grain = tex("paper_grain")
	return _grain

## Soft radial glow (white → transparent) for additive light.
static func glow() -> GradientTexture2D:
	if _glow:
		return _glow
	var g := Gradient.new()
	g.set_color(0, Color(1, 1, 1, 1))
	g.set_color(1, Color(1, 1, 1, 0))
	g.add_point(0.35, Color(1, 1, 1, 0.55))
	_glow = GradientTexture2D.new()
	_glow.gradient = g
	_glow.fill = GradientTexture2D.FILL_RADIAL
	_glow.fill_from = Vector2(0.5, 0.5)
	_glow.fill_to = Vector2(1.0, 0.5)
	_glow.width = 128
	_glow.height = 128
	return _glow

# =====================================================================
# Shapes
# =====================================================================

## A rectangle whose edges wobble like torn paper / a brushed frame.
static func brush_poly(rect: Rect2, seed: int = 1, rough: float = T.BRUSH_ROUGH, step: float = 10.0) -> PackedVector2Array:
	var rng := RandomNumberGenerator.new()
	rng.seed = seed
	var pts := PackedVector2Array()
	var nx := maxi(2, int(rect.size.x / step))
	var ny := maxi(2, int(rect.size.y / step))
	for i in nx:  # top, left → right
		pts.append(rect.position + Vector2(rect.size.x * i / nx, rng.randf_range(-rough, rough)))
	for i in ny:  # right, top → bottom
		pts.append(rect.position + Vector2(rect.size.x + rng.randf_range(-rough, rough), rect.size.y * i / ny))
	for i in nx:  # bottom, right → left
		pts.append(rect.position + Vector2(rect.size.x * (nx - i) / nx, rect.size.y + rng.randf_range(-rough, rough)))
	for i in ny:  # left, bottom → top
		pts.append(rect.position + Vector2(rng.randf_range(-rough, rough), rect.size.y * (ny - i) / ny))
	return pts

## A horizontal brush stroke: full-bodied middle, dry tapered ends.
static func stroke_poly(rect: Rect2, seed: int = 1) -> PackedVector2Array:
	var rng := RandomNumberGenerator.new()
	rng.seed = seed
	var top := PackedVector2Array()
	var bot := PackedVector2Array()
	var n := maxi(8, int(rect.size.x / 8.0))
	var h := rect.size.y
	for i in n + 1:
		var t := float(i) / n
		# taper: ends thin out, the start blunt, the tail flicks up a little
		var body := clampf(minf(t / 0.08, (1.0 - t) / 0.14), 0.0, 1.0)
		body = 0.35 + 0.65 * sqrt(body)
		var cy := rect.position.y + h * 0.5 - (t - 0.5) * h * 0.06
		var half := h * 0.5 * body
		var x := rect.position.x + rect.size.x * t
		top.append(Vector2(x, cy - half + rng.randf_range(-1.2, 1.2)))
		bot.append(Vector2(x, cy + half + rng.randf_range(-1.6, 1.6)))
	bot.reverse()
	top.append_array(bot)
	return top

# =====================================================================
# Drawing helpers (call from a CanvasItem's _draw)
# =====================================================================

## Fill a polygon with parchment (color × grain). Needs texture_repeat on the node.
static func fill_paper(ci: CanvasItem, pts: PackedVector2Array, color: Color = T.PAPER) -> void:
	var uvs := PackedVector2Array()
	for p in pts:
		uvs.append(p / 512.0)
	ci.draw_colored_polygon(pts, color, uvs, grain())

## The parchment 9-slice (torn, burnt edge) shared by the theme and sheets.
static func parchment_box() -> StyleBoxTexture:
	if _parch_box == null:
		_parch_box = StyleBoxTexture.new()
		_parch_box.texture = tex("parchment")
		for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
			_parch_box.set_texture_margin(side, 56)
		_parch_box.axis_stretch_horizontal = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
		_parch_box.axis_stretch_vertical = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
	return _parch_box

## Parchment sheet: torn burnt-edge paper with a soft ink shadow under it.
## `color` tints the paper (PAPER = untinted).
static func paper_sheet(ci: CanvasItem, rect: Rect2, _seed: int = 1, color: Color = T.PAPER, shadow: bool = true) -> void:
	var box := parchment_box()
	var tint := Color.WHITE
	if color != T.PAPER:
		tint = Color(color.r / T.PAPER.r, color.g / T.PAPER.g, color.b / T.PAPER.b, color.a).clamp()
	# small sheets get a finer torn edge (the 9-slice drawn at a smaller scale)
	var k := clampf(minf(rect.size.x, rect.size.y) / 220.0, 0.5, 1.0)
	var local := Rect2(Vector2.ZERO, rect.size / k)
	if shadow:
		ci.draw_set_transform(rect.position + Vector2(4, 7), 0.0, Vector2(k, k))
		box.modulate_color = Color(0.1, 0.06, 0.03, 0.28)
		box.draw(ci.get_canvas_item(), local)
	ci.draw_set_transform(rect.position, 0.0, Vector2(k, k))
	box.modulate_color = tint
	box.draw(ci.get_canvas_item(), local)
	box.modulate_color = Color.WHITE
	ci.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

## A dry-brush stroke stretched into rect (dry tail on the right).
static func stroke(ci: CanvasItem, rect: Rect2, color: Color, flip: bool = false) -> void:
	_quad(ci, tex("brush_stroke"), rect, color, flip)

## A broad ink wash (wide, softer stroke) stretched into rect.
static func wash(ci: CanvasItem, rect: Rect2, color: Color, flip: bool = false) -> void:
	_quad(ci, tex("brush_wash"), rect, color, flip)

## Texture into rect, optionally mirrored left↔right (via UVs, so the
## caller's draw transform is left alone).
static func _quad(ci: CanvasItem, t: Texture2D, r: Rect2, color: Color, flip: bool) -> void:
	if not flip:
		ci.draw_texture_rect(t, r, false, color)
		return
	ci.draw_primitive(PackedVector2Array([r.position, Vector2(r.end.x, r.position.y), r.end, Vector2(r.position.x, r.end.y)]),
			PackedColorArray([color, color, color, color]),
			PackedVector2Array([Vector2(1, 0), Vector2(0, 0), Vector2(0, 1), Vector2(1, 1)]), t)

## A lacquered wooden scroll rod with capped knobs, spanning [x0, x1] centered on y.
static func rod(ci: CanvasItem, x0: float, x1: float, y: float, h: float = T.ROD_H) -> void:
	var r := Rect2(Vector2(x0, y - h * 0.5), Vector2(x1 - x0, h))
	ci.draw_texture_rect(tex("rod"), Rect2(r.position + Vector2(0, 3), r.size), false, Color(0, 0, 0, 0.3))
	ci.draw_texture_rect(tex("rod"), r, false)
	var k := h * 1.7
	for x in [x0, x1]:
		ci.draw_texture_rect(tex("knob"), Rect2(Vector2(x, y) - Vector2(k, k) * 0.5, Vector2(k, k)), false)

## The same rod standing upright (for horizontal scrolls).
static func vrod(ci: CanvasItem, x: float, y0: float, y1: float, h: float = T.ROD_H) -> void:
	ci.draw_set_transform(Vector2(x, y0), PI * 0.5, Vector2.ONE)
	rod(ci, 0.0, y1 - y0, 0.0, h)
	ci.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

## Red cord + tassel hanging from a point.
static func tassel(ci: CanvasItem, at: Vector2, length: float = 26.0, sway: float = 0.0) -> void:
	var end := at + Vector2(sway * 6.0, length)
	ci.draw_line(at, end, T.RIBBON, 2.0, true)
	ci.draw_circle(end, 3.0, T.VERMILION_DEEP)
	ci.draw_colored_polygon(PackedVector2Array([end + Vector2(-4, 2), end + Vector2(4, 2),
			end + Vector2(5 + sway * 2, 16), end + Vector2(-5 + sway * 2, 16)]), T.RIBBON)

## Vermilion seal stamp (square chop) with text.
static func seal(ci: CanvasItem, rect: Rect2, text: String, seed: int = 3) -> void:
	ci.draw_colored_polygon(brush_poly(rect, seed, 1.5, 6.0), T.VERMILION)
	ci.draw_polyline(_closed(brush_poly(rect.grow(-3), seed + 1, 1.0, 6.0)), Color(T.PAPER_LIGHT, 0.55), 1.0, true)
	var f := T.font("label")
	var fs := int(rect.size.y * 0.5)
	var w := f.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
	ci.draw_string(f, rect.get_center() + Vector2(-w / 2.0, fs * 0.36), text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, T.PAPER_LIGHT)

## Ink frame around a rect (brushed, slightly uneven).
static func ink_frame(ci: CanvasItem, rect: Rect2, color: Color = T.INK, width: float = T.BORDER_INK, seed: int = 5) -> void:
	ci.draw_polyline(_closed(brush_poly(rect, seed, 1.0, 14.0)), color, width, true)

static func _closed(pts: PackedVector2Array) -> PackedVector2Array:
	var p := pts.duplicate()
	p.append(pts[0])
	return p

static func closed(pts: PackedVector2Array) -> PackedVector2Array:
	return _closed(pts)
