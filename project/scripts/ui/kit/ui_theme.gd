@tool
extends RefCounted

## Builds the project Theme from ui_tokens.gd. Brush and parchment textures
## come from res://assets/ui/paint/ (generated by tools/paint/gen_textures.py).
## The generated file (res://assets/ui/scroll_ink_theme.tres) is the project's
## custom theme, so every scene uses it, in game and in the editor.
## Regenerate after changing tokens:
##   Godot --headless --path project --script res://tools/build_theme.gd
##
## Theme type variations (set a Control's "Theme Type Variation"):
##   Buttons: PrimaryButton (vermilion brush), SecondaryButton (ink brush),
##            Button (ghost: ink text, brushed underline), SmallButton (paper tag)
##   Labels:  DisplayLabel (brush script), TitleLabel, H1Label, H2Label, H3Label,
##            BodyLabel, CaptionLabel, EyebrowLabel
##   Panels:  PanelContainer (parchment), GlassPanel (ink wash), ChipPanel

const T = preload("res://scripts/ui/kit/ui_tokens.gd")

static func build() -> Theme:
	var th := Theme.new()
	th.default_font = T.font("body")
	th.default_font_size = T.FS_BODY
	_buttons(th)
	_labels(th)
	_inputs(th)
	_panels(th)
	_misc(th)
	return th

# ------------------------------------------------------------------ helpers

static func flat(bg: Color, border: Color = Color(0, 0, 0, 0), bw: int = 0, pad_x: float = 16, pad_y: float = 8) -> StyleBoxFlat:
	var sb := StyleBoxFlat.new()
	sb.bg_color = bg
	sb.border_color = border
	sb.set_border_width_all(bw)
	sb.content_margin_left = pad_x
	sb.content_margin_right = pad_x
	sb.content_margin_top = pad_y
	sb.content_margin_bottom = pad_y
	sb.anti_aliasing = true
	return sb

static func tex_box(tex: Texture2D, tint: Color, margin_x: float, margin_y: float, pad_x: float = 26, pad_y: float = 10) -> StyleBoxTexture:
	var sb := StyleBoxTexture.new()
	sb.texture = tex
	sb.modulate_color = tint
	sb.texture_margin_left = margin_x
	sb.texture_margin_right = margin_x
	sb.texture_margin_top = margin_y
	sb.texture_margin_bottom = margin_y
	sb.axis_stretch_horizontal = StyleBoxTexture.AXIS_STRETCH_MODE_STRETCH
	sb.axis_stretch_vertical = StyleBoxTexture.AXIS_STRETCH_MODE_STRETCH
	sb.content_margin_left = pad_x
	sb.content_margin_right = pad_x
	sb.content_margin_top = pad_y
	sb.content_margin_bottom = pad_y
	return sb

## Keyboard focus: an ink underline beneath the control (fits brush shapes).
static func focus_box() -> StyleBoxTexture:
	var sb := tex_box(load("res://assets/ui/paint/button_underline.png"), T.INK, 60, 0, 0, 0)
	sb.expand_margin_bottom = 10
	sb.expand_margin_left = -10
	sb.expand_margin_right = -10
	return sb

static func _font_colors(th: Theme, type: String, text: Color, hover: Color, disabled: Color) -> void:
	th.set_color("font_color", type, text)
	th.set_color("font_hover_color", type, hover)
	th.set_color("font_pressed_color", type, text)
	th.set_color("font_hover_pressed_color", type, hover)
	th.set_color("font_focus_color", type, hover)
	th.set_color("font_disabled_color", type, disabled)

# ------------------------------------------------------------------ sections

static func _buttons(th: Theme) -> void:
	var brush: Texture2D = load("res://assets/ui/paint/brush_button.png")
	var under: Texture2D = load("res://assets/ui/paint/button_underline.png")

	# Ghost (default): ink text on an underline that warms to red on hover.
	th.set_stylebox("normal", "Button", tex_box(under, Color(T.INK, 0.35), 60, 0, 18, 10))
	th.set_stylebox("hover", "Button", tex_box(under, T.VERMILION, 60, 0, 18, 10))
	th.set_stylebox("pressed", "Button", tex_box(under, T.VERMILION_DEEP, 60, 0, 18, 10))
	th.set_stylebox("hover_pressed", "Button", tex_box(under, T.VERMILION_DEEP, 60, 0, 18, 10))
	th.set_stylebox("disabled", "Button", StyleBoxEmpty.new())
	th.set_stylebox("focus", "Button", focus_box())
	_font_colors(th, "Button", T.INK, T.VERMILION, Color(T.INK_FAINT, 0.6))
	th.set_font("font", "Button", T.font("heading"))
	th.set_font_size("font_size", "Button", T.FS_H3)

	# Primary: a vermilion brush stroke.
	th.set_type_variation("PrimaryButton", "Button")
	th.set_stylebox("normal", "PrimaryButton", tex_box(brush, T.VERMILION, 70, 0, 34, 14))
	th.set_stylebox("hover", "PrimaryButton", tex_box(brush, T.VERMILION_HOVER, 70, 0, 34, 14))
	th.set_stylebox("pressed", "PrimaryButton", tex_box(brush, T.VERMILION_DEEP, 70, 0, 34, 14))
	th.set_stylebox("hover_pressed", "PrimaryButton", tex_box(brush, T.VERMILION_DEEP, 70, 0, 34, 14))
	th.set_stylebox("disabled", "PrimaryButton", tex_box(brush, Color(T.INK, 0.3), 70, 0, 34, 14))
	_font_colors(th, "PrimaryButton", T.PAPER_LIGHT, T.PAPER_LIGHT, T.INK_FAINT)

	# Secondary: an ink brush stroke.
	th.set_type_variation("SecondaryButton", "Button")
	th.set_stylebox("normal", "SecondaryButton", tex_box(brush, T.INK, 70, 0, 34, 14))
	th.set_stylebox("hover", "SecondaryButton", tex_box(brush, T.INK_SOFT, 70, 0, 34, 14))
	th.set_stylebox("pressed", "SecondaryButton", tex_box(brush, T.WOOD_DARK, 70, 0, 34, 14))
	th.set_stylebox("hover_pressed", "SecondaryButton", tex_box(brush, T.WOOD_DARK, 70, 0, 34, 14))
	th.set_stylebox("disabled", "SecondaryButton", tex_box(brush, Color(T.INK, 0.3), 70, 0, 34, 14))
	_font_colors(th, "SecondaryButton", T.PAPER_LIGHT, T.SIDE_YOU, T.INK_FAINT)

	# Small: a paper tag with an ink border (COPY IP, LEAVE).
	th.set_type_variation("SmallButton", "Button")
	th.set_stylebox("normal", "SmallButton", flat(T.PAPER_LIGHT, T.INK, 2, 14, 4))
	th.set_stylebox("hover", "SmallButton", flat(T.PAPER_LIGHT, T.VERMILION, 2, 14, 4))
	th.set_stylebox("pressed", "SmallButton", flat(T.PAPER_DARK, T.VERMILION_DEEP, 2, 14, 4))
	th.set_stylebox("hover_pressed", "SmallButton", flat(T.PAPER_DARK, T.VERMILION_DEEP, 2, 14, 4))
	th.set_stylebox("disabled", "SmallButton", flat(Color(T.PAPER_DARK, 0.5), Color(T.INK, 0.25), 2, 14, 4))
	_font_colors(th, "SmallButton", T.INK, T.VERMILION, T.INK_FAINT)
	th.set_font("font", "SmallButton", T.font("label"))
	th.set_font_size("font_size", "SmallButton", T.FS_LABEL)

static func _label_var(th: Theme, name: String, font_role: String, size: int, color: Color,
		glow: bool = false) -> void:
	th.set_type_variation(name, "Label")
	th.set_font("font", name, T.font(font_role))
	th.set_font_size("font_size", name, size)
	th.set_color("font_color", name, color)
	if glow:
		# A soft paper halo keeps ink type readable over the golden sky.
		th.set_color("font_shadow_color", name, Color(T.PAPER_LIGHT, 0.55))
		th.set_constant("shadow_offset_x", name, 0)
		th.set_constant("shadow_offset_y", name, 3)
		th.set_constant("shadow_outline_size", name, 6)

static func _labels(th: Theme) -> void:
	th.set_color("font_color", "Label", T.INK)
	th.set_font("font", "Label", T.font("body"))
	th.set_font_size("font_size", "Label", T.FS_BODY)

	_label_var(th, "DisplayLabel", "display", T.FS_DISPLAY, T.INK, true)
	_label_var(th, "TitleLabel", "heading", T.FS_TITLE, T.INK, true)
	_label_var(th, "H1Label", "heading", T.FS_H1, T.INK, true)
	_label_var(th, "H2Label", "heading", T.FS_H2, T.INK)
	_label_var(th, "H3Label", "heading", T.FS_H3, T.INK)
	_label_var(th, "BodyLabel", "body", T.FS_BODY, T.INK_SOFT)
	_label_var(th, "CaptionLabel", "label", T.FS_CAPTION, T.INK_FAINT)

	var eyebrow := FontVariation.new()
	eyebrow.base_font = T.font("label")
	eyebrow.spacing_glyph = 4
	th.set_type_variation("EyebrowLabel", "Label")
	th.set_font("font", "EyebrowLabel", eyebrow)
	th.set_font_size("font_size", "EyebrowLabel", T.FS_LABEL)
	th.set_color("font_color", "EyebrowLabel", T.VERMILION)

static func _inputs(th: Theme) -> void:
	var normal := flat(Color(T.PAPER_LIGHT, 0.82), T.INK_SOFT, 0, 14, 10)
	normal.border_width_bottom = 2
	var focus := flat(T.PAPER_LIGHT, T.VERMILION, 0, 14, 10)
	focus.border_width_bottom = 3
	th.set_stylebox("normal", "LineEdit", normal)
	th.set_stylebox("focus", "LineEdit", focus)
	var ro := flat(Color(T.PAPER_DARK, 0.5), Color(T.INK, 0.25), 0, 14, 10)
	ro.border_width_bottom = 1
	th.set_stylebox("read_only", "LineEdit", ro)
	th.set_font("font", "LineEdit", T.font("body_strong"))
	th.set_font_size("font_size", "LineEdit", 22)
	th.set_color("font_color", "LineEdit", T.INK)
	th.set_color("font_uneditable_color", "LineEdit", T.INK_FAINT)
	th.set_color("font_placeholder_color", "LineEdit", T.INK_FAINT)
	th.set_color("caret_color", "LineEdit", T.VERMILION)
	th.set_color("selection_color", "LineEdit", Color(T.VERMILION, 0.25))
	th.set_constant("caret_width", "LineEdit", 2)

static func _panels(th: Theme) -> void:
	var parch: Texture2D = load("res://assets/ui/paint/parchment.png")
	var panel := tex_box(parch, Color.WHITE, 56, 56, 34, 28)
	panel.axis_stretch_horizontal = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
	panel.axis_stretch_vertical = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
	th.set_stylebox("panel", "PanelContainer", panel)
	th.set_stylebox("panel", "Panel", panel)

	th.set_type_variation("GlassPanel", "PanelContainer")
	th.set_stylebox("panel", "GlassPanel", flat(T.INK_WASH, Color(0, 0, 0, 0), 0, 16, 12))

	th.set_type_variation("ChipPanel", "PanelContainer")
	th.set_stylebox("panel", "ChipPanel", flat(T.PAPER_LIGHT, T.INK, 1, 8, 2))

static func _misc(th: Theme) -> void:
	th.set_stylebox("panel", "TooltipPanel", flat(T.PAPER_LIGHT, T.INK, 1, 12, 8))
	th.set_color("font_color", "TooltipLabel", T.INK)
	th.set_stylebox("background", "ProgressBar", flat(Color(T.INK, 0.6), T.INK, 1, 0, 0))
	th.set_stylebox("fill", "ProgressBar", flat(T.SIDE_YOU, Color(0, 0, 0, 0), 0, 0, 0))
	th.set_stylebox("separator", "HSeparator", flat(Color(T.INK, 0.3), Color(0, 0, 0, 0), 0, 0, 0))
	th.set_constant("separation", "HSeparator", 1)
