; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be manually edited.

[application]

config/name="Legend of Lion Turtle"
config/description="A 1v1 elemental-bending PvP arena game inspired by Avatar: The Last Airbender"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/app_icon.png"
boot_splash/bg_color=Color(0.164706, 0.121569, 0.0901961, 1)
boot_splash/show_image=false

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
UserSettings="*res://scripts/autoload/user_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/scroll_ink_theme.tres"

